{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode：Vite 通过 esbuild 以 ESM 方式加载 vite.config.ts，
       故按 bundler 解析（与 tsconfig.app.json 一致）。不可用 nodenext：
       项目 package.json 为 "type": "commonjs"，nodenext 会把 .ts 当 CJS，
       与 verbatimModuleSyntax 冲突（TS1295），且会把 @vitejs/plugin-react
       解析到 CJS 互操作入口 viteReactForCjs（options 必填，TS2554）。 */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
