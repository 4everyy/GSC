/**
 * RallyPointPanel 样式 —— 集结点面板内容部分（参数区容器 / 集结队形下拉选择器）。
 * tab 栏样式见 PanelTabs.css，起飞高度/集结速度步进行样式见 HeightStepper.css，
 * 飞机列表区块样式见 AircraftListPanel.css（复用 AircraftListSection），
 * 外壳样式复用 PanelShell.css；「.rally-point-panel」仅作页面级定位钩子（HomePage.css）。
 */

/* 参数区容器：宽度与 HeightStepper 行对齐（244px），纵向排布高度/速度步进与队形选择行 */
.rally-point-panel__params {
  width: 244px;
  margin: 16px 0 0 8px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* 队形行：标签 + 下拉选择器。
 * 下拉框左边缘与上方步进行的步进按钮列左对齐：
 * label 56px 宽（同 .height-stepper__label）+ 下拉框 m-left 16（同 − 按钮 m-left 16）= 72px 起点一致 */
.rally-point-panel__formation {
  display: flex;
  align-items: center;
}

/* 标签：56px 宽 + 14px 白色（与 HeightStepper 标签一致） */
.rally-point-panel__formation-label {
  width: 56px;
  color: rgba(255, 255, 255, 1);
  font-size: 14px;
  font-family: MiSans-Regular, sans-serif;
  line-height: 14px;
  white-space: nowrap;
}

/* 下拉选择器：宽度与上方步进行整组控件的【实测渲染宽度】一致（132px，同区域降落面板编队行）。
 * 视觉同风格（白 20% 底 + 60% 白描边） */
.rally-point-panel__select {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: 16px;
  width: 132px;
  height: 28px;
  padding: 0 4px;
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 2px;
  box-sizing: border-box;
  cursor: pointer;
  user-select: none;
}

/* 选中值：14px 白色（与数值框文字一致），占据除图标外的剩余宽度 */
.rally-point-panel__select-value {
  flex: 1;
  color: rgba(255, 255, 255, 1);
  font-size: 14px;
  font-family: MiSans-Regular, sans-serif;
  line-height: 14px;
  white-space: nowrap;
}

.rally-point-panel__select img {
  width: 11px;
  height: 11px;
  pointer-events: none;
  transition: transform 0.2s ease;
}

/* 展开态：箭头旋转 180° */
.rally-point-panel__select--open img {
  transform: rotate(180deg);
}

/* 下拉菜单：绝对定位于选择器下方，深色底 + 白色描边（与选择框同风格） */
.rally-point-panel__dropdown {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  z-index: 10;
  background: rgba(10, 25, 47, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 2px;
  overflow: hidden;
}

/* 选项行：hover 高亮；当前选中项青色文字 */
.rally-point-panel__dropdown-item {
  padding: 6px 8px;
  color: rgba(255, 255, 255, 0.85);
  font-size: 12px;
  font-family: MiSans-Regular, sans-serif;
  line-height: 12px;
  cursor: pointer;
}

.rally-point-panel__dropdown-item:hover {
  background: rgba(255, 255, 255, 0.25);
}

.rally-point-panel__dropdown-item--active {
  color: rgba(83, 255, 233, 1);
}