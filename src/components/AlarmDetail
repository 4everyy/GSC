/* ====== 告警信息详情面板（弹层，紧贴常驻告警框下方） ======
   设计稿 box_6：414×632（1920×1080 基准），随视口 clamp 等比缩放。
   定位：绝对定位于 .alarm-info-panel 容器底部（HomePage 中包一层 wrapper），
   右缘与常驻告警框对齐。 */
.alarm-detail-panel {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  margin-top: clamp(5.5px, 0.57vw, 11px);
  box-sizing: border-box;
  height: clamp(316px, 32.92vw, 632px);
  padding: 0;
  pointer-events: auto;
}

/* 背景切图铺在独立伪元素层，单独控制透明度 */
.alarm-detail-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url('../../assets/images/home/alarm-detail-bg.png') center / 100% 100% no-repeat;
  opacity: 0.9;
  pointer-events: none;
  z-index: 0;
}

.alarm-detail-panel > * {
  position: relative;
  z-index: 1;
}

/* ====== 标题行 ====== */
.alarm-detail-panel__header {
  display: flex;
  align-items: center;
  height: clamp(10.5px, 1.09vw, 21px);
  margin: clamp(6px, 0.63vw, 12px) 0 0 clamp(15px, 1.51vw, 29px);
  gap: clamp(4px, 0.52vw, 10px);
}

.alarm-detail-panel__header-icon {
  width: clamp(7px, 0.73vw, 14px);
  height: clamp(7px, 0.73vw, 14px);
}

.alarm-detail-panel__title {
  color: #fff;
  font-size: clamp(8px, 0.83vw, 16px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

/* 右上角关闭按钮（透明热区，装饰性 X 由背景切图承担） */
.alarm-detail-panel__close {
  margin-left: auto;
  margin-right: clamp(7px, 0.73vw, 14px);
  width: clamp(8px, 0.83vw, 16px);
  height: clamp(8px, 0.83vw, 16px);
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
}

/* ====== 提示行（与常驻面板同款样式） ====== */
.alarm-detail-panel__rows {
  display: flex;
  flex-direction: column;
}

.alarm-detail-panel__row {
  display: flex;
  align-items: center;
  margin-top: clamp(6px, 1.07vw, 20.5px);
  padding-left: clamp(12px, 1.25vw, 24px);
  padding-right: clamp(12px, 1.41vw, 27px);
  gap: clamp(3px, 0.31vw, 6px);
}

.alarm-detail-panel__row-text {
  flex: 1;
  min-width: 0;
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #fff;
}

.alarm-detail-panel__row-text--yellow {
  color: #f3c200;
}

.alarm-detail-panel__row-close {
  flex-shrink: 0;
  width: clamp(8px, 0.83vw, 16px);
  height: clamp(8px, 0.83vw, 16px);
  margin-left: clamp(6px, 1.35vw, 26px);
  cursor: pointer;
}

/* ====== 筛选条 ====== */
.alarm-detail-panel__filter {
  position: relative;
  display: flex;
  align-items: center;
  height: clamp(20.5px, 2.14vw, 41px);
  margin-top: clamp(6px, 0.73vw, 14px);
}

.alarm-detail-panel__filter-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
}

/* 筛选条内文字/图标均置于背景层之上 */
.alarm-detail-panel__filter > *:not(.alarm-detail-panel__filter-bg) {
  position: relative;
}

.alarm-detail-panel__filter-icon {
  width: clamp(7px, 0.73vw, 14px);
  height: clamp(7px, 0.73vw, 14px);
  margin-left: clamp(10px, 1.04vw, 20px);
  align-self: center;
}

.alarm-detail-panel__filter-title {
  align-self: center;
  margin-left: clamp(4px, 0.52vw, 10px);
  color: #fff;
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.alarm-detail-panel__filter-status-label {
  align-self: center;
  margin-left: clamp(10px, 1.04vw, 20px);
  color: #fff;
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

/* 下拉框（处理状态）：背景切图已含输入框框体，仅布局文字与箭头 */
.alarm-detail-panel__select {
  display: flex;
  align-items: center;
  margin-left: auto;
  margin-right: clamp(6px, 0.73vw, 14px);
  gap: clamp(3px, 0.31vw, 6px);
  padding: 0 clamp(4px, 0.42vw, 8px);
}

.alarm-detail-panel__select-text {
  color: #fff;
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.alarm-detail-panel__select-arrow {
  width: clamp(8px, 0.83vw, 16px);
  height: clamp(8px, 0.83vw, 16px);
}

/* ====== 事件卡片列表 ====== */
.alarm-detail-panel__events {
  position: relative;
  display: flex;
  flex-direction: column;
  margin-top: clamp(6px, 0.73vw, 14px);
}

/* 单个事件 = 时间轴节点 + 卡片 */
.alarm-detail-panel__event {
  display: flex;
  align-items: flex-start;
}

/* 事件之间垂直间距 */
.alarm-detail-panel__event + .alarm-detail-panel__event {
  margin-top: clamp(5px, 0.57vw, 11px);
}

/* 时间轴节点：50×50 切图取左上 -24px 的 35×35 精灵区域 + 中心 3×3 白点 */
.alarm-detail-panel__node {
  position: relative;
  flex-shrink: 0;
  width: clamp(17.5px, 1.82vw, 35px);
  height: clamp(17.5px, 1.82vw, 35px);
  margin-left: clamp(3px, 0.36vw, 7px);
  background: url('../../assets/images/home/alarm-detail-node.png') no-repeat;
  background-position: calc(-1 * clamp(12px, 1.25vw, 24px)) 0;
  background-size: clamp(25px, 2.6vw, 50px) clamp(25px, 2.6vw, 50px);
}

.alarm-detail-panel__node-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: clamp(1.5px, 0.16vw, 3px);
  height: clamp(1.5px, 0.16vw, 3px);
  background: #fff;
}

/* 卡片主体 */
.alarm-detail-panel__card {
  flex: 1;
  min-width: 0;
  margin-left: clamp(5px, 0.57vw, 11px);
  margin-right: clamp(11px, 1.15vw, 22px);
}

/* 卡片头：标题 + 时间 + 状态徽章 */
.alarm-detail-panel__card-head {
  display: flex;
  align-items: center;
  height: clamp(10.5px, 1.09vw, 21px);
}

.alarm-detail-panel__card-title {
  color: #fff;
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.alarm-detail-panel__card-time {
  margin-left: clamp(4px, 0.42vw, 8px);
  color: rgba(255, 255, 205, 0.8);
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.alarm-detail-panel__card-status {
  margin-left: auto;
  width: clamp(12px, 1.25vw, 24px);
  height: clamp(12px, 1.25vw, 24px);
}

/* 卡片分隔线 */
.alarm-detail-panel__card-divider {
  height: clamp(1px, 0.1vw, 2px);
  margin-top: clamp(2px, 0.26vw, 5px);
  background: rgba(255, 255, 255, 0.15);
}

/* 卡片正文：无人机 + 告警文本 */
.alarm-detail-panel__card-body {
  display: flex;
  align-items: center;
  height: clamp(10.5px, 1.09vw, 21px);
  margin-top: clamp(2px, 0.26vw, 5px);
  gap: clamp(3px, 0.31vw, 6px);
}

.alarm-detail-panel__card-drone-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: clamp(2px, 0.21vw, 4px);
}

.alarm-detail-panel__card-drone {
  width: clamp(13px, 1.35vw, 26px);
  height: clamp(13px, 1.35vw, 26px);
}

.alarm-detail-panel__card-drone-name {
  color: #fff;
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.alarm-detail-panel__card-text {
  flex: 1;
  min-width: 0;
  margin-left: clamp(4px, 0.42vw, 8px);
  color: rgba(255, 255, 255, 0.8);
  font-size: clamp(7px, 0.73vw, 14px);
  font-family: 'MiSans-Medium', 'MiSans-Regular', sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧滚动条装饰 */
.alarm-detail-panel__scrollbar {
  position: absolute;
  right: clamp(2px, 0.21vw, 4px);
  top: 50%;
  transform: translateY(-50%);
  width: clamp(2px, 0.21vw, 4px);
  height: clamp(40px, 4.17vw, 80px);
  background: url('../../assets/images/home/alarm-detail-scrollbar.png') center / 100% 100%
    no-repeat;
}

/* ====== 告警色调（与常驻告警框同步） ====== */
.alarm-detail-panel--red {
  box-shadow: inset 0 0 0 1px rgba(243, 44, 48, 0.55),
    inset 0 0 clamp(10px, 1.56vw, 30px) rgba(243, 44, 48, 0.2);
}

.alarm-detail-panel--orange {
  box-shadow: inset 0 0 0 1px rgba(243, 194, 0, 0.55),
    inset 0 0 clamp(10px, 1.56vw, 30px) rgba(243, 194, 0, 0.18);
}

.alarm-detail-panel--blue {
  box-shadow: inset 0 0 0 1px rgba(64, 158, 255, 0.55),
    inset 0 0 clamp(10px, 1.56vw, 30px) rgba(64, 158, 255, 0.18);
}