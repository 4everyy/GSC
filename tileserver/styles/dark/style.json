{
  "name": "GCS Dark Matter",
  "description": "暗色科技风底图样式，适配 GCS 大屏 UI。基于 OpenMapTiles schema。",
  "version": 8,
  "sources": {
    "suzhou": {
      "type": "vector",
      "url": "mbtiles://suzhou.mbtiles",
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0a1a2f" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#0d2438" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#101e33" }
    },
    {
      "id": "landuse-industrial",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "landuse",
      "filter": ["==", "class", "industrial"],
      "paint": { "fill-color": "#1a1a2e" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": { "fill-color": "#0f1e15" }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "suzhou",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": { "line-color": "#2a4a6b", "line-width": 1.2 }
    },
    {
      "id": "boundary-city",
      "type": "line",
      "source": "suzhou",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 6],
      "paint": {
        "line-color": "#1e3a5f",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "suzhou",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "paint": {
        "line-color": "#1a2f4a",
        "line-width": {
          "base": 1.2,
          "stops": [[14, 0.5], [18, 3]]
        }
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "suzhou",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#2a4a6b",
        "line-width": {
          "base": 1.2,
          "stops": [[10, 0.5], [18, 6]]
        }
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "suzhou",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#3a6b9c",
        "line-width": {
          "base": 1.2,
          "stops": [[10, 1], [18, 8]]
        }
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "suzhou",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#4a8bc0",
        "line-width": {
          "base": 1.2,
          "stops": [[8, 1], [18, 12]]
        }
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "building",
      "minzoom": 15,
      "paint": { "fill-color": "#162538", "fill-opacity": 0.8 }
    },
    {
      "id": "place-city-major",
      "type": "symbol",
      "source": "suzhou",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": "{name:zh} {name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 14,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#e0f0ff",
        "text-halo-color": "#0a1a2f",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "suzhou",
      "source-layer": "place",
      "filter": ["==", "class", "village"],
      "minzoom": 12,
      "layout": {
        "text-field": "{name:zh} {name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#b0c4d8",
        "text-halo-color": "#0a1a2f",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "suzhou",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": "{name:zh} {name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-offset": [0, 1.2]
      },
      "paint": {
        "text-color": "#8090a8",
        "text-halo-color": "#0a1a2f",
        "text-halo-width": 1
      }
    }
  ]
}