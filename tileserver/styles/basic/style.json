{
  "name": "GCS Basic",
  "description": "亮色底图样式（备选），基于 OpenMapTiles schema。",
  "version": 8,
  "sources": {
    "suzhou": {
      "type": "vector",
      "url": "mbtiles://suzhou.mbtiles",
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f5f5f5" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "water",
      "paint": { "fill-color": "#aaccff" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e8e8e8" }
    },
    {
      "id": "road",
      "type": "line",
      "source": "suzhou",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#888",
        "line-width": { "base": 1.2, "stops": [[10, 0.5], [18, 6]] }
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "suzhou",
      "source-layer": "building",
      "minzoom": 15,
      "paint": { "fill-color": "#d0d0d0" }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "suzhou",
      "source-layer": "place",
      "layout": {
        "text-field": "{name:zh} {name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 13
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    }
  ]
}