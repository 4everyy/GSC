# ============================================================
# MapLibre 离线瓦片服务配置（环境变量示例）
# ============================================================
# 复制本文件为 .env.local 并按实际部署修改：
#   copy .env.example .env.local
#
# 开发环境（使用 MapLibre 官方 demo 瓦片，需联网）：
#   不设置此项，默认使用 demotiles.maplibre.org
#
# 离线/生产环境（使用本地 tileserver-gl）：
#   VITE_MAPLIBRE_STYLE_URL=http://localhost:8081/styles/dark/style.json
#   （默认端口 8081，避免与现有 uav-task-server 的 8080 冲突）
# ============================================================

# MapLibre Style JSON 地址
# - 开发默认：https://demotiles.maplibre.org/style.json
# - 离线部署：http://<tileserver-host>:8081/styles/dark/style.json
VITE_MAPLIBRE_STYLE_URL=http://localhost:8081/styles/dark/style.json

# MapLibre 默认中心点（WGS84）与缩放级别
# 默认苏州市中心（120.6, 31.3），与本地瓦片数据覆盖范围匹配
VITE_MAPLIBRE_CENTER_LNG=120.6
VITE_MAPLIBRE_CENTER_LAT=31.3
VITE_MAPLIBRE_DEFAULT_ZOOM=12

# 部署到其他机器时，将 localhost 替换为瓦片服务器 IP，例如：
# VITE_MAPLIBRE_STYLE_URL=http://192.168.1.100:8081/styles/dark/style.json
