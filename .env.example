# ============================================================
# MapLibre 离线瓦片服务配置（环境变量示例）
# ============================================================
# 复制本文件为 .env.local 并按实际部署修改：
#   copy .env.example .env.local
#
# 默认行为（推荐）：
#   不设置 VITE_MAPLIBRE_STYLE_URL，前端默认使用同源相对路径
#   /tiles/styles/dark/style.json，由 Vite dev-server / preview proxy
#   或生产环境 Nginx 代理转发到 tileserver-gl（localhost:8081）。
#   这样无论从 localhost / LAN IP / IPv6 访问页面都不会出现
#   "Failed to fetch (0)" 错误。
#
# 需要指定其他瓦片服务器时，取消注释并替换为绝对 URL：
#   VITE_MAPLIBRE_STYLE_URL=http://192.168.1.100:8081/styles/dark/style.json
# ============================================================

# MapLibre Style JSON 地址（默认走同源代理，无需设置）
# VITE_MAPLIBRE_STYLE_URL=/tiles/styles/dark/style.json

# MapLibre 默认中心点（WGS84）与缩放级别
# 默认苏州市中心（120.6, 31.3），与本地瓦片数据覆盖范围匹配
VITE_MAPLIBRE_CENTER_LNG=120.6
VITE_MAPLIBRE_CENTER_LAT=31.3
VITE_MAPLIBRE_DEFAULT_ZOOM=12