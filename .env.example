# ============================================================
# 环境变量示例 —— 复制为 .env.local 后按实际环境修改
# .env.local 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# --- WebSocket 连接（联调真实后端时配置）---------------------
# 方式一【推荐·开发联调】：不配置 VITE_WS_URL，前端默认连同源 /ws，
#   由 Vite dev server 代理转发，代理目标由下行变量控制：
VITE_WS_PROXY_TARGET=ws://192.168.120.30:8080

# 方式二【直连】：配置完整 WebSocket 地址，前端绕过代理直连后端。
#   注意浏览器跨域限制——后端需允许该 Origin，否则握手会被拒绝：
# VITE_WS_URL=ws://192.168.120.30:8080

# 生产环境：通常由 nginx 反代 /ws 到后端（见部署文档），前端保持默认即可；
# 若直连，则在构建时注入：VITE_WS_URL=wss://your-domain/ws

# --- HTTP API 代理（联调真实后端时配置）---------------------
# 设备状态轮询等 HTTP 请求默认连同源 /api/*，由 Vite dev server 代理转发：
VITE_API_PROXY_TARGET=http://192.168.120.30:8080
# 生产环境：由 nginx 反代 /api 到后端，前端保持默认即可。

# --- 后端联调总开关 -----------------------------------------
# 开发模式默认关闭（纯前端 mock 开发，不发起 HTTP/WS 请求，避免代理失败报错）；
# 联调真实后端时设为 true；生产构建始终启用。
# VITE_BACKEND_ENABLED=true

# --- Auth (auto logon, see src/api/auth.ts) -----------------------------
# Auto POST /iam/logon with form username=...&password=<md5> on first HTTP
# request; token stored in localStorage and sent as token request header.
# Defaults are the joint-debug account; override in .env.local if changed.
VITE_AUTH_USERNAME=13222222222
VITE_AUTH_PASSWORD_MD5=718969750e4ae33ace0c8ebae788e525
